GROQ_API_KEY=

# Modelo com visão da Groq, usado pra ler comprovantes compartilhados (opcional —
# se não configurar, usa o padrão em api/receipt-import.js. Confere no console da
# Groq se esse modelo ainda existe antes de contar com ele em produção).
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Supabase (banco de dados + login)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (notificações) - gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
